{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Node",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleSuffixes": [
      ".ts",
      ".tsx",
      ""
    ],
    "paths": {
      "*": [
        "*",
        "./src/*"
      ]
    },
    "types": [
      "chrome"
    ],
    "baseUrl": "."
  }
}
