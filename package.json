{
  "name": "web-recall",
  "version": "0.3.0",
  "description": "Web Recall 0.2.x workspace tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "build:beta": "node scripts/build-beta.mjs",
    "apple:build": "swift build --package-path native/apple --configuration release && node scripts/build-apple-app.mjs",
    "apple:build:debug": "swift build --package-path native/apple && node scripts/build-apple-app.mjs --debug",
    "apple:test": "swift test --package-path native/apple",
    "apple:update:keygen": "swift run --package-path native/apple WebRecallUpdater keygen native/apple/update-public-key.txt",
    "apple:package": "node scripts/package-apple.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "node --test --test-timeout=30000 tests/*.test.mjs",
    "test:setup": "playwright-core install --with-deps chromium",
    "bench:recall": "node scripts/recall-benchmark.mjs",
    "qualify:capture": "node scripts/qualify-capture.mjs",
    "package:extension": "node scripts/package-extension.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/chrome": "^0.0.266",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.3.0",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "26.1.0",
    "playwright-core": "1.65.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.47.0"
  },
  "packageManager": "pnpm@9.15.2"
}
